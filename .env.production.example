# Plantilla de nombres; reemplazar todos los CHANGE_ME mediante variables
# protegidas o un gestor de secretos. No copiar este archivo como credencial.
IQBF_DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/iqbf
IQBF_JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
IQBF_AUTH_MODE=local
IQBF_ACCESS_TOKEN_MINUTES=30
IQBF_CORS_ORIGINS=https://CHANGE_ME_FRONTEND_HOST
IQBF_ENVIRONMENT=production

# URL pública de la API. Aparece en el bloque servers del OpenAPI que consume
# el frontend; si queda en localhost, el contrato publicado apunta al host
# equivocado.
IQBF_PUBLIC_BASE_URL=https://CHANGE_ME_API_HOST

# Presupuesto de conexiones. La aplicación abre un pool POR PROCESO, así que
# el consumo total contra PostgreSQL es:
#
#     IQBF_POOL_MAX_SIZE x number_de_replicas  <=  max_connections - reserva
#
# Deje una reserva (5-10 conexiones) para migraciones, respaldos y psql de
# administración. Antes de escalar réplicas, baje este valor en la misma
# proporción: duplicar instancias sin ajustarlo agota la base.
#
# Referencia: 5 x 1 replica = 5 conexiones, suficiente para decenas de
# usuarios concurrentes en el alcance actual del sistema.
IQBF_POOL_MIN_SIZE=2
IQBF_POOL_MAX_SIZE=5

# Espera máxima por una conexión libre antes de responder 503 con Retry-After.
# Manténgalo por debajo del tiempo de espera del proxy o balanceador.
IQBF_POOL_TIMEOUT=10
