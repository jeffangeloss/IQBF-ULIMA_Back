IQBF_DATABASE_URL=postgresql://127.0.0.1:5432/iqbf_mvp
IQBF_JWT_SECRET=reemplace-por-un-secreto-aleatorio-de-al-menos-32-caracteres
IQBF_AUTH_MODE=local
IQBF_ACCESS_TOKEN_MINUTES=30
IQBF_CORS_ORIGINS=http://localhost:5173
IQBF_ENVIRONMENT=development
IQBF_PUBLIC_BASE_URL=http://127.0.0.1:8000
# El pool es por proceso: max_size x replicas <= max_connections - reserva.
# La nota extendida está en .env.production.example.
IQBF_POOL_MIN_SIZE=1
IQBF_POOL_MAX_SIZE=10
IQBF_POOL_TIMEOUT=10
